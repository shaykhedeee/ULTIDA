{
  "name": "ultida",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:packages": "node scripts/build.mjs packages",
    "build:apps": "node scripts/build.mjs apps",
    "build:cloudflare-worker": "npm run build --workspace=@ultida/cloudflare-ai-worker",
    "deploy:cloudflare-worker": "wrangler deploy --config apps/cloudflare-ai-worker/wrangler.toml",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "test:drawing": "node scripts/test.mjs drawing",
    "test:api": "node scripts/test.mjs api",
    "test:rooms": "node scripts/test.mjs rooms",
    "test:render": "node scripts/test.mjs render",
    "test:aura": "node scripts/test.mjs aura",
    "preflight": "node scripts/preflight.mjs",
    "validate:reliability": "node scripts/validate-reliability.mjs",
    "reliability": "npm run validate:reliability && npm run preflight && npm run check && npm run build && npm run test:drawing && npm run test:api && npm run test:aura && npm run test:render && npm run test:rooms",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5"
  }
}
