{
  "version": 2,
  "installCommand": "npm install --include=optional --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "{apps/api/dist/**,packages/**/dist/**,node_modules/@ultida/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
