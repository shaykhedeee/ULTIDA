{
  "version": 2,
  "installCommand": "npm install --include=optional --no-audit --no-fund",
  "buildCommand": "npm run build --workspaces --if-present",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
